# Get a key at https://platform.deepseek.com (Sign up -> API Keys -> Create new key)
DEEPSEEK_API_KEY=sk-...

# Optional but recommended: powers live web search grounding for current hotel/
# restaurant/activity suggestions. Without this, the app still works, but relies
# entirely on the AI's trained knowledge instead of a live search.
# Get a free-tier key at https://tavily.com (Sign up -> API Keys)
TAVILY_API_KEY=tvly-...
